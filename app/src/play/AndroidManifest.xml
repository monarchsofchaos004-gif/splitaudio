<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- INTERNET: the built-in ADB client talks to this phone's own adbd over a TCP socket (127.0.0.1 / the phone's own Wi-Fi address), and the app
         talks to the routing helper's control port (TCP 127.0.0.1:47821; token + uid checked). No data leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Foreground service type "connectedDevice" (MonitorService, PairService): it needs this permission and, on Android 14+, one of the
         CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE / CHANGE_WIFI_MULTICAST_STATE permissions (the last one is declared below) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- Needed by Android's NSD (mDNS) discovery of the phone's own Wireless debugging service -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Granted to ourselves once, through the paired ADB connection (pm grant); used only to switch Wireless debugging back on after a reboot -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions"/>
    <!-- Guards: libadb-android's manifest has no targetSdk, so the manifest merger used to add legacy storage/phone-state permissions (not with minSdk 31,
         hence the "no other declaration present" merger warnings). We never use them; keep this so a library update cannot bring them back. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
    <application android:name=".adb.App" tools:replace="android:name">
        <activity android:name=".adb.LicensesActivity" android:exported="false" android:label="@string/lic_title"/>
        <!-- the monitor that starts the router when Bluetooth is connected and music plays (it also reconnects the built-in ADB when Wi-Fi comes up) -->
        <service android:name=".MonitorService" android:exported="false" android:foregroundServiceType="connectedDevice"/>
        <!-- finds the phone's own Wireless debugging pairing service (mDNS) and takes the pairing code from a notification -->
        <service android:name=".adb.PairService" android:exported="false" android:foregroundServiceType="connectedDevice"/>
        <receiver android:name=".adb.PairReceiver" android:exported="false"/>
    </application>
</manifest>
