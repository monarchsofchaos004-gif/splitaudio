<resources>
    <!-- Play flavor only: built-in ADB setup (pairing, notifications, licenses). Shared strings live in src/main. -->
    <string name="sec_setup">一次性設定</string>
    <string name="setup_done_title">設定完成 ✓</string>
    <string name="setup_done_d">之後重開機只要連上 WiFi，SplitAudio 會自己接回。</string>
    <string name="setup_redo">再看一次設定步驟</string>
    <string name="chip_done">完成 ✓</string>
    <string name="chip_todo">待辦</string>
