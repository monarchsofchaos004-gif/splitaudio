<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is used only for the local control port of the routing helper (TCP 127.0.0.1:47821, loopback only): the app and VolKeyService
         connect to it. Every connection has to start with the app's own random token and come from this app's uid, so other apps cannot use the port.
         No data leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application>
        <!-- the monitor that starts the router when Bluetooth is connected and music plays -->
        <service android:name=".MonitorService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="per-app audio routing monitor"/>
        </service>
        <!-- volume keys (accessibility); not in the play flavor -->
        <service android:name=".VolKeyService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/volkey"/>
        </service>
    </application>
</manifest>
